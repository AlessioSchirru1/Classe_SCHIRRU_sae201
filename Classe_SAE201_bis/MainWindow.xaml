<Window x:Class="Classe_SAE201_bis.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PAUL - Gestion"
        Height="800"
        Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#F5EDE3"
        WindowStyle="None"
        AllowsTransparency="True">

    <Window.Resources>
        <!-- Style bouton menu normal -->
        <Style x:Key="MenuBtnStyle"
               TargetType="Button">
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="Foreground"
                    Value="#E8D5C4" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="FontSize"
                    Value="14" />
            <Setter Property="Height"
                    Value="44" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Left" />
            <Setter Property="Padding"
                    Value="16,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Margin="8,2">
                            <ContentPresenter VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="#9B6A3E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style bouton menu actif -->
        <Style x:Key="MenuBtnActiveStyle"
               TargetType="Button"
               BasedOn="{StaticResource MenuBtnStyle}">
            <Setter Property="Background"
                    Value="#5A2E1A" />
            <Setter Property="Foreground"
                    Value="White" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Border CornerRadius="12"
            ClipToBounds="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ========== SIDEBAR ========== -->
            <Border Grid.Column="0"
                    Background="#7B4A2D">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Avatar + Nom + Rôle -->
                    <StackPanel Grid.Row="0"
                                HorizontalAlignment="Center"
                                Margin="0,28,0,24">
                        <Border Width="52"
                                Height="52"
                                CornerRadius="26"
                                Background="#5A2E1A"
                                HorizontalAlignment="Center">
                            <TextBlock x:Name="TxtInitiales"
                                       Text="MD"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="TxtNomSalarie"
                                   Text="Marie Dubois"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,2" />
                        <TextBlock x:Name="TxtRoleSalarie"
                                   Text="Vendeur"
                                   FontSize="11"
                                   Foreground="#D4B89A"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Menu items -->
                    <StackPanel x:Name="PanelMenu"
                                Grid.Row="1"
                                Margin="0,8,0,0" />

                    <!-- Déconnexion -->
                    <Button Grid.Row="2"
                            Content="⬅ Déconnexion"
                            Style="{StaticResource MenuBtnStyle}"
                            Foreground="#D4B89A"
                            Margin="8,0,8,16"
                            Click="BtnDeconnexion_Click" />
                </Grid>
            </Border>

            <!-- ========== ZONE CONTENU ========== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="36" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Barre de titre custom (drag) -->
                <Border Grid.Row="0"
                        Background="#F5EDE3"
                        MouseLeftButtonDown="BarreTitre_MouseDown">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0">
                        <Button Content="✕"
                                Width="28"
                                Height="28"
                                FontSize="13"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Foreground="#7B4A2D"
                                Click="BtnFermer_Click" />
                    </StackPanel>
                </Border>

                <!-- Contenu principal -->
                <Frame x:Name="FrameContenu"
                       Grid.Row="1"
                       NavigationUIVisibility="Hidden"
                       Background="Transparent" />
            </Grid>
        </Grid>
    </Border>
</Window>
