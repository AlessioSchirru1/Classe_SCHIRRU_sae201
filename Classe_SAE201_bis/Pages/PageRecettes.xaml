<Page x:Class="Classe_SAE201_bis.Pages.PageRecettes"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Classe_SAE201_bis.Pages"
      mc:Ignorable="d"
      Background="#F5EDE3"
      Title="PageRecettes">

    <Page.Resources>
        <Style x:Key="FiltreBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#2C1810"/>
            <Setter Property="BorderBrush" Value="#D4B89A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FiltreBtnActiveStyle" TargetType="Button"
               BasedOn="{StaticResource FiltreBtnStyle}">
            <Setter Property="Background" Value="#6B3A2A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#6B3A2A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="BtnPrincipalStyle" TargetType="Button">
            <Setter Property="Background" Value="#6B3A2A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BtnSecondaireStyle" TargetType="Button"
               BasedOn="{StaticResource BtnPrincipalStyle}">
            <Setter Property="Background" Value="#F5EDE4"/>
            <Setter Property="Foreground" Value="#6B3A2A"/>
        </Style>
    </Page.Resources>

    <Grid Margin="32,28,32,28">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <!-- Colonne gauche : liste recettes -->
        <Grid Grid.Column="0" Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Recettes" FontSize="26"
                       FontWeight="Bold" Foreground="#2C1810" Margin="0,0,0,20"/>

            <!-- Filtres catégorie -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                <Button x:Name="BtnTous" Content="Toutes" Tag="Toutes"
                        Style="{StaticResource FiltreBtnActiveStyle}"
                        Click="FiltreBtn_Click" Margin="0,0,8,0"/>
                <Button Content="Gâteaux" Tag="Gâteaux"
                        Style="{StaticResource FiltreBtnStyle}"
                        Click="FiltreBtn_Click" Margin="0,0,8,0"/>
                <Button Content="Viennoiseries" Tag="Viennoiseries"
                        Style="{StaticResource FiltreBtnStyle}"
                        Click="FiltreBtn_Click" Margin="0,0,8,0"/>
                <Button Content="Pains" Tag="Pains"
                        Style="{StaticResource FiltreBtnStyle}"
                        Click="FiltreBtn_Click"/>
            </StackPanel>

            <!-- Liste -->
            <Border Grid.Row="2" Background="White" CornerRadius="12">
                <DataGrid x:Name="GridRecettes" AutoGenerateColumns="False"
                          IsReadOnly="True" GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column" BorderThickness="0"
                          Background="White" RowBackground="White"
                          AlternatingRowBackground="#FAFAFA"
                          HorizontalGridLinesBrush="#F0E8E0"
                          SelectionMode="Single" CanUserResizeColumns="False"
                          CanUserReorderColumns="False" FontSize="13"
                          Foreground="#2C1810" Margin="16,8,16,8"
                          SelectionChanged="GridRecettes_SelectionChanged">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="Foreground" Value="#888"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="8,10"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Recette" Binding="{Binding Nom}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Catégorie" Binding="{Binding Categorie}" Width="120" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Allergènes" Binding="{Binding AllergenesStr}" Width="160" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Nb formats" Binding="{Binding NbFormats}" Width="90" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- Colonne droite : fiche détail -->
        <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="24">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Mode : aucune sélection -->
                    <StackPanel x:Name="PanelAucune">
                        <TextBlock Text="📖" FontSize="36" HorizontalAlignment="Center" Margin="0,40,0,12"/>
                        <TextBlock Text="Sélectionnez une recette" FontSize="14"
                                   Foreground="#888" HorizontalAlignment="Center"
                                   TextAlignment="Center"/>
                    </StackPanel>

                    <!-- Mode : fiche / édition -->
                    <StackPanel x:Name="PanelFiche" Visibility="Collapsed">

                        <!-- En-tête fiche -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtTitreFiche" FontSize="17"
                                       FontWeight="Bold" Foreground="#2C1810"
                                       TextWrapping="Wrap" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" x:Name="BtnEditer"
                                    Content="✏ Modifier" Click="BtnEditer_Click"
                                    Style="{StaticResource BtnSecondaireStyle}"
                                    Height="30" Padding="12,0" FontSize="12"/>
                        </Grid>

                        <!-- Catégorie -->
                        <TextBlock Text="CATÉGORIE" FontSize="10" Foreground="#888"
                                   FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock x:Name="TxtCategorieFiche" FontSize="13"
                                   Foreground="#2C1810" Margin="0,0,0,14"/>

                        <!-- Description -->
                        <TextBlock Text="DESCRIPTION" FontSize="10" Foreground="#888"
                                   FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <Border BorderBrush="#F0E8E0" BorderThickness="1"
                                CornerRadius="6" Padding="10,8" Margin="0,0,0,14">
                            <TextBlock x:Name="TxtDescFiche" FontSize="13"
                                       Foreground="#2C1810" TextWrapping="Wrap"/>
                        </Border>

                        <!-- Allergènes -->
                        <TextBlock Text="ALLERGÈNES" FontSize="10" Foreground="#888"
                                   FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <WrapPanel x:Name="PanelAllergenes" Margin="0,0,0,16"/>

                        <!-- Séparateur -->
                        <Border Height="1" Background="#F0E8E0" Margin="0,4,0,16"/>

                        <!-- Formats & Prix -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="FORMATS ET PRIX"
                                       FontSize="10" Foreground="#888"
                                       FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="+ Ajouter"
                                    x:Name="BtnAjouterFormat"
                                    Click="BtnAjouterFormat_Click"
                                    Style="{StaticResource BtnPrincipalStyle}"
                                    Height="26" Padding="10,0" FontSize="11"/>
                        </Grid>

                        <ItemsControl x:Name="ListeFormats">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FDF6EC" CornerRadius="8"
                                            Padding="12,8" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding FormatStr}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="#2C1810"/>
                                                <TextBlock Text="{Binding PrixStr}"
                                                           FontSize="12" Foreground="#6B4226"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="✏"
                                                    Tag="{Binding ProduitId}"
                                                    Click="BtnModifierPrix_Click"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    FontSize="14" Cursor="Hand"
                                                    Margin="0,0,8,0"/>
                                            <Button Grid.Column="2" Content="🗑"
                                                    Tag="{Binding ProduitId}"
                                                    Click="BtnSupprimerFormat_Click"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    FontSize="14" Cursor="Hand"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Formulaire modification recette (masqué par défaut) -->
                        <Border x:Name="PanelEdition" Visibility="Collapsed"
                                Background="#FDF6EC" CornerRadius="8"
                                Padding="16" Margin="0,12,0,0"
                                BorderBrush="#D4B89A" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Modifier la recette" FontSize="14"
                                           FontWeight="Bold" Foreground="#2C1810" Margin="0,0,0,12"/>

                                <TextBlock Text="Nom" FontSize="12" Foreground="#888" Margin="0,0,0,4"/>
                                <Border BorderBrush="#D4B89A" BorderThickness="1" CornerRadius="6"
                                        Padding="10,8" Margin="0,0,0,10">
                                    <TextBox x:Name="TxtEditNom" BorderThickness="0"
                                             Background="Transparent" FontSize="13"/>
                                </Border>

                                <TextBlock Text="Description" FontSize="12" Foreground="#888" Margin="0,0,0,4"/>
                                <Border BorderBrush="#D4B89A" BorderThickness="1" CornerRadius="6"
                                        Padding="10,8" Margin="0,0,0,10">
                                    <TextBox x:Name="TxtEditDesc" BorderThickness="0"
                                             Background="Transparent" FontSize="13"
                                             TextWrapping="Wrap" Height="60"
                                             AcceptsReturn="True"/>
                                </Border>

                                <TextBlock Text="Allergènes" FontSize="12" Foreground="#888" Margin="0,0,0,6"/>
                                <ListBox x:Name="ListEditAllergenes" BorderThickness="0"
                                         Background="Transparent" MaxHeight="140" FontSize="12">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Nom}"
                                                      IsChecked="{Binding Coche}"
                                                      Foreground="#2C1810"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <TextBlock x:Name="TxtErreurEdit" Foreground="#C0392B"
                                           FontSize="12" Margin="0,8,0,0" Visibility="Collapsed"/>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="Annuler"
                                            Click="BtnAnnulerEdit_Click"
                                            Style="{StaticResource BtnSecondaireStyle}"
                                            Height="36" Padding="0,0"/>
                                    <Button Grid.Column="2" Content="Enregistrer"
                                            Click="BtnSauvegarderEdit_Click"
                                            Style="{StaticResource BtnPrincipalStyle}"
                                            Height="36" Padding="0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
