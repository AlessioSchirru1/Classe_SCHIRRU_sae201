<Page x:Class="Classe_SAE201_bis.Pages.PageCommandesDuJour"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Classe_SAE201_bis.Pages"
      mc:Ignorable="d"
      Background="#F5EDE3"
      Title="PageCommandesDuJour">

    <Page.Resources>
        <Style x:Key="CarteStyle"
               TargetType="Border">
            <Setter Property="Background"
                    Value="White" />
            <Setter Property="CornerRadius"
                    Value="12" />
            <Setter Property="Padding"
                    Value="20,16" />
        </Style>
        <Style x:Key="BtnActionStyle"
               TargetType="Button">
            <Setter Property="Height"
                    Value="30" />
            <Setter Property="Padding"
                    Value="12,0" />
            <Setter Property="FontSize"
                    Value="12" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="Foreground"
                    Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="32,28,32,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Titre + date -->
            <StackPanel Grid.Row="0"
                        Margin="0,0,0,20">
                <TextBlock Text="Commandes du jour"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#2C1810" />
                <TextBlock x:Name="TxtDate"
                           FontSize="13"
                           Foreground="#888"
                           Margin="0,4,0,0" />
            </StackPanel>

            <!-- Cartes stats -->
            <Grid Grid.Row="1"
                  Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Total -->
                <Border Grid.Column="0"
                        Style="{StaticResource CarteStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Total commandes"
                                       FontSize="13"
                                       Foreground="#555"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="🛒"
                                       FontSize="18"
                                       Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="TxtTotal"
                                   Text="0"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="#2C1810"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- À retirer -->
                <Border Grid.Column="2"
                        Style="{StaticResource CarteStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="À retirer"
                                       FontSize="13"
                                       Foreground="#555"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="⏰"
                                       FontSize="18"
                                       Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="TxtARetirer"
                                   Text="0"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="#FF9800"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- Prêtes -->
                <Border Grid.Column="4"
                        Style="{StaticResource CarteStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Prêtes"
                                       FontSize="13"
                                       Foreground="#555"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="✅"
                                       FontSize="18"
                                       Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="TxtPretes"
                                   Text="0"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="#4CAF50"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- Restituées -->
                <Border Grid.Column="6"
                        Style="{StaticResource CarteStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Restituées"
                                       FontSize="13"
                                       Foreground="#555"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="📦"
                                       FontSize="18"
                                       Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="TxtRestituees"
                                   Text="0"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="#9E9E9E"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Titre liste -->
            <TextBlock Grid.Row="2"
                       Text="Liste des commandes"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="#2C1810"
                       Margin="0,0,0,12" />

            <!-- Tableau -->
            <Border Grid.Row="3"
                    Background="White"
                    CornerRadius="12">
                <DataGrid x:Name="GridCommandes"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          BorderThickness="0"
                          Background="White"
                          RowBackground="White"
                          AlternatingRowBackground="#FAFAFA"
                          HorizontalGridLinesBrush="#F0E8E0"
                          SelectionMode="Single"
                          CanUserResizeColumns="False"
                          CanUserReorderColumns="False"
                          FontSize="13"
                          Foreground="#2C1810"
                          Margin="16,8,16,8">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background"
                                    Value="White" />
                            <Setter Property="Foreground"
                                    Value="#888" />
                            <Setter Property="FontSize"
                                    Value="12" />
                            <Setter Property="FontWeight"
                                    Value="SemiBold" />
                            <Setter Property="Padding"
                                    Value="8,10" />
                            <Setter Property="BorderThickness"
                                    Value="0" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Columns>
                        
                        <DataGridTextColumn Header="Client"
                                            Binding="{Binding NomClient}"
                                            Width="160" />
                        <DataGridTextColumn Header="Produits"
                                            Binding="{Binding Produits}"
                                            Width="200" />
                        <DataGridTextColumn Header="Total"
                                            Binding="{Binding TotalStr}"
                                            Width="100" />

                        <!-- Statut badge -->
                        <DataGridTemplateColumn Header="Statut"
                                                Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="12"
                                            Padding="10,4"
                                            Background="{Binding CouleurStatut}"
                                            HorizontalAlignment="Left"
                                            Margin="0,4">
                                        <TextBlock Text="{Binding StatutStr}"
                                                   Foreground="White"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Actions -->
                        <DataGridTemplateColumn Header="Actions"
                                                Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,4">
                                        <Button Content="Restituer"
                                                Visibility="{Binding ShowBtnRestituer}"
                                                Style="{StaticResource BtnActionStyle}"
                                                Background="#6B3A2A"
                                                Tag="{Binding CommandeId}"
                                                Click="BtnRestituer_Click"
                                                Margin="0,0,8,0" />
                                        <Button Content="✏️ Modifier"
                                                Style="{StaticResource BtnActionStyle}"
                                                Background="#2196F3"
                                                Tag="{Binding CommandeId}"
                                                Click="BtnModifier_Click" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
