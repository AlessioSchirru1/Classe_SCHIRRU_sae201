<Page x:Class="Classe_SAE201_bis.Pages.PageNouvelleCommande"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Classe_SAE201_bis.Pages"
      mc:Ignorable="d"
      Background="#F5EDE3"
      Title="PageNouvelleCommande">

    <Page.Resources>
        <Style x:Key="FiltreBtnStyle"
               TargetType="Button">
            <Setter Property="Background"
                    Value="White" />
            <Setter Property="Foreground"
                    Value="#2C1810" />
            <Setter Property="BorderBrush"
                    Value="#D4B89A" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="FontSize"
                    Value="13" />
            <Setter Property="Height"
                    Value="32" />
            <Setter Property="Padding"
                    Value="14,0" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FiltreBtnActiveStyle"
               TargetType="Button"
               BasedOn="{StaticResource FiltreBtnStyle}">
            <Setter Property="Background"
                    Value="#6B3A2A" />
            <Setter Property="Foreground"
                    Value="White" />
            <Setter Property="BorderBrush"
                    Value="#6B3A2A" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
        </Style>
        <Style x:Key="BtnPrincipalStyle"
               TargetType="Button">
            <Setter Property="Height"
                    Value="40" />
            <Setter Property="Padding"
                    Value="20,0" />
            <Setter Property="FontSize"
                    Value="13" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Background"
                    Value="#6B3A2A" />
            <Setter Property="Foreground"
                    Value="White" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BtnSecondaireStyle"
               TargetType="Button"
               BasedOn="{StaticResource BtnPrincipalStyle}">
            <Setter Property="Background"
                    Value="White" />
            <Setter Property="Foreground"
                    Value="#2C1810" />
            <Setter Property="BorderBrush"
                    Value="#D4B89A" />
            <Setter Property="BorderThickness"
                    Value="1" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header : titre + étapes -->
        <Border Grid.Row="0"
                Background="#F5EDE3"
                Padding="32,20,32,16">
            <StackPanel>
                <TextBlock Text="Nouvelle commande"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#2C1810"
                           Margin="0,0,0,16" />
                <!-- Indicateur étapes -->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <!-- Étape 1 -->
                    <Border x:Name="Etape1Cercle"
                            Width="28"
                            Height="28"
                            CornerRadius="14"
                            Background="#6B3A2A">
                        <TextBlock Text="1"
                                   Foreground="White"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="Etape1Txt"
                               Text=" Produits"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#6B3A2A"
                               VerticalAlignment="Center" />
                    <Rectangle Fill="#D4B89A"
                               Height="1"
                               Width="80"
                               Margin="8,0" />
                    <!-- Étape 2 -->
                    <Border x:Name="Etape2Cercle"
                            Width="28"
                            Height="28"
                            CornerRadius="14"
                            Background="#D4B89A">
                        <TextBlock Text="2"
                                   Foreground="White"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="Etape2Txt"
                               Text=" Client / Événement"
                               FontSize="13"
                               Foreground="#D4B89A"
                               VerticalAlignment="Center" />
                    <Rectangle Fill="#D4B89A"
                               Height="1"
                               Width="80"
                               Margin="8,0" />
                    <!-- Étape 3 -->
                    <Border x:Name="Etape3Cercle"
                            Width="28"
                            Height="28"
                            CornerRadius="14"
                            Background="#D4B89A">
                        <TextBlock Text="3"
                                   Foreground="White"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="Etape3Txt"
                               Text=" Récapitulatif"
                               FontSize="13"
                               Foreground="#D4B89A"
                               VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Contenu -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <Grid Margin="32,16,32,16">

                <!-- ========== ÉTAPE 1 : PRODUITS ========== -->
                <Grid x:Name="PanelEtape1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="240" />
                    </Grid.ColumnDefinitions>

                    <!-- Gauche : catalogue -->
                    <StackPanel Grid.Column="0">
                        <!-- Recherche -->
                        <Border Background="White"
                                CornerRadius="10"
                                Margin="0,0,0,12"
                                Padding="12,8">
                            <Grid>
                                <TextBox x:Name="TxtRechercheProduit"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         FontSize="14"
                                         Foreground="#2C1810"
                                         CaretBrush="#2C1810"
                                         VerticalContentAlignment="Center"
                                         Height="30"
                                         TextChanged="TxtRechercheProduit_TextChanged" />
                                <TextBlock x:Name="PlaceholderProduit"
                                           Text="🔍  Rechercher un produit..."
                                           Foreground="#AAAAAA"
                                           FontSize="14"
                                           VerticalAlignment="Center"
                                           Margin="2,0,0,0"
                                           IsHitTestVisible="False" />
                            </Grid>
                        </Border>

                        <!-- Filtres catégorie -->
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,16">
                            <Button x:Name="BtnTous"
                                    Content="Tous"
                                    Style="{StaticResource FiltreBtnActiveStyle}"
                                    Margin="0,0,8,0"
                                    Click="FiltreCat_Click"
                                    Tag="Tous" />
                            <Button x:Name="BtnGateaux"
                                    Content="Gâteaux"
                                    Style="{StaticResource FiltreBtnStyle}"
                                    Margin="0,0,8,0"
                                    Click="FiltreCat_Click"
                                    Tag="Gâteaux" />
                            <Button x:Name="BtnViennoiseries"
                                    Content="Viennoiseries"
                                    Style="{StaticResource FiltreBtnStyle}"
                                    Margin="0,0,8,0"
                                    Click="FiltreCat_Click"
                                    Tag="Viennoiseries" />
                            <Button x:Name="BtnPains"
                                    Content="Pains"
                                    Style="{StaticResource FiltreBtnStyle}"
                                    Click="FiltreCat_Click"
                                    Tag="Pains" />
                        </StackPanel>

                        <!-- Grille produits -->
                        <ItemsControl x:Name="ListeProduits">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="200"
                                            Margin="0,0,12,12"
                                            Background="White"
                                            CornerRadius="12"
                                            Padding="16">
                                        <StackPanel>
                                            <TextBlock Text="{Binding RecetteNom}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="#2C1810"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Description}"
                                                       FontSize="11"
                                                       Foreground="#888"
                                                       TextWrapping="Wrap"
                                                       Margin="0,4,0,6"
                                                       MaxHeight="36"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Allergenes}"
                                                       FontSize="10"
                                                       Foreground="#B07050"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,8" />
                                            <ComboBox x:Name="CbFormat"
                                                      ItemsSource="{Binding Formats}"
                                                      DisplayMemberPath="Libelle"
                                                      Height="30"
                                                      FontSize="12"
                                                      Tag="{Binding RecetteId}"
                                                      SelectionChanged="CbFormat_SelectionChanged" />
                                            <Button Content="+ Ajouter"
                                                    Margin="0,8,0,0"
                                                    Height="32"
                                                    FontSize="12"
                                                    Background="{Binding CouleurAjouter}"
                                                    Foreground="White"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    Tag="{Binding RecetteId}"
                                                    Click="BtnAjouter_Click"
                                                    IsEnabled="{Binding PeutAjouter}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                CornerRadius="6"
                                                                Opacity="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsEnabled, Converter={x:Null}}">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Droite : Ma commande -->
                    <Border Grid.Column="2"
                            Background="White"
                            CornerRadius="12"
                            Padding="16"
                            VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Ma commande"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="#2C1810"
                                       Margin="0,0,0,12" />
                            <ItemsControl x:Name="ListeSelection">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#F0E8E0"
                                                BorderThickness="0,0,0,1"
                                                Padding="0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Nom}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="#2C1810" />
                                                    <TextBlock Text="{Binding Format}"
                                                               FontSize="11"
                                                               Foreground="#888" />
                                                    <StackPanel Orientation="Horizontal"
                                                                Margin="0,4,0,0">
                                                        <Button Content="−"
                                                                Width="24"
                                                                Height="24"
                                                                FontSize="14"
                                                                Background="#F5EDE3"
                                                                Foreground="#2C1810"
                                                                BorderThickness="0"
                                                                Cursor="Hand"
                                                                Tag="{Binding ProduitId}"
                                                                Click="BtnMoins_Click">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}"
                                                                            CornerRadius="4">
                                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                                          VerticalAlignment="Center" />
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                        <TextBlock Text="{Binding Quantite}"
                                                                   FontSize="13"
                                                                   VerticalAlignment="Center"
                                                                   Margin="8,0" />
                                                        <Button Content="+"
                                                                Width="24"
                                                                Height="24"
                                                                FontSize="14"
                                                                Background="#F5EDE3"
                                                                Foreground="#2C1810"
                                                                BorderThickness="0"
                                                                Cursor="Hand"
                                                                Tag="{Binding ProduitId}"
                                                                Click="BtnPlus_Click">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}"
                                                                            CornerRadius="4">
                                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                                          VerticalAlignment="Center" />
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                    </StackPanel>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding SousTotalStr}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="#2C1810"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="TxtPanier0"
                                       Text="Aucun produit ajouté"
                                       FontSize="12"
                                       Foreground="#AAAAAA"
                                       HorizontalAlignment="Center"
                                       Margin="0,16,0,0" />
                            <Border BorderBrush="#F0E8E0"
                                    BorderThickness="0,1,0,0"
                                    Margin="0,12,0,0"
                                    Padding="0,12,0,0">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="Total HT"
                                                   FontSize="13"
                                                   Foreground="#555" />
                                        <TextBlock x:Name="TxtTotalHT"
                                                   Text="0,00 €"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Foreground="#2C1810"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                    <Grid Margin="0,4,0,0">
                                        <TextBlock Text="Acompte (25%)"
                                                   FontSize="12"
                                                   Foreground="#888" />
                                        <TextBlock x:Name="TxtAcompte"
                                                   Text="0,00 €"
                                                   FontSize="12"
                                                   Foreground="#888"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ========== ÉTAPE 2 : CLIENT + ÉVÉNEMENT ========== -->
                <Grid x:Name="PanelEtape2"
                      Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Client -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Client"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#2C1810"
                                   Margin="0,0,0,12" />
                        <Border Background="White"
                                CornerRadius="12"
                                Padding="16">
                            <StackPanel>
                                <!-- Recherche client -->
                                <Border Background="#F5EDE3"
                                        CornerRadius="8"
                                        Margin="0,0,0,12"
                                        Padding="10,8">
                                    <Grid>
                                        <TextBox x:Name="TxtRechercheClient"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 FontSize="13"
                                                 Foreground="#2C1810"
                                                 CaretBrush="#2C1810"
                                                 VerticalContentAlignment="Center"
                                                 Height="28"
                                                 TextChanged="TxtRechercheClient_TextChanged" />
                                        <TextBlock x:Name="PlaceholderClient"
                                                   Text="🔍  Rechercher un client par nom ou téléphone..."
                                                   Foreground="#AAAAAA"
                                                   FontSize="13"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False" />
                                    </Grid>
                                </Border>

                                <!-- Liste clients -->
                                <ScrollViewer MaxHeight="200"
                                              VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="ListeClients">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="BdClient"
                                                        BorderBrush="#F0E8E0"
                                                        BorderThickness="0,0,0,1"
                                                        Padding="8,10"
                                                        Cursor="Hand"
                                                        MouseLeftButtonDown="ClientItem_Click"
                                                        Tag="{Binding ClientId}"
                                                        Background="Transparent">
                                                    <Grid>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding NomComplet}"
                                                                       FontSize="13"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="#2C1810" />
                                                            <TextBlock Text="{Binding Telephone}"
                                                                       FontSize="11"
                                                                       Foreground="#888" />
                                                        </StackPanel>
                                                        <TextBlock Text="✓"
                                                                   Foreground="#4CAF50"
                                                                   FontSize="16"
                                                                   HorizontalAlignment="Right"
                                                                   VerticalAlignment="Center"
                                                                   Visibility="{Binding EstSelectionne}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <!-- Créer nouveau client -->
                                <Button Content="+ Créer un nouveau client"
                                        HorizontalAlignment="Left"
                                        Margin="0,12,0,0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="#6B3A2A"
                                        FontSize="13"
                                        Cursor="Hand"
                                        Click="BtnCreerNouveauClient_Click" />

                                <!-- Formulaire nouveau client (caché par défaut) -->
                                <Border x:Name="PanelNouveauClient"
                                        Visibility="Collapsed"
                                        Background="#F5EDE3"
                                        CornerRadius="8"
                                        Padding="12"
                                        Margin="0,12,0,0">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Nom *"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="#2C1810"
                                                           Margin="0,0,0,4" />
                                                <Border Background="White"
                                                        CornerRadius="6"
                                                        Padding="8,6">
                                                    <TextBox x:Name="TxtNomNC"
                                                             BorderThickness="0"
                                                             Background="Transparent"
                                                             FontSize="13" />
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Prénom"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="#2C1810"
                                                           Margin="0,0,0,4" />
                                                <Border Background="White"
                                                        CornerRadius="6"
                                                        Padding="8,6">
                                                    <TextBox x:Name="TxtPrenomNC"
                                                             BorderThickness="0"
                                                             Background="Transparent"
                                                             FontSize="13" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Téléphone *"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="#2C1810"
                                                           Margin="0,0,0,4" />
                                                <Border Background="White"
                                                        CornerRadius="6"
                                                        Padding="8,6">
                                                    <TextBox x:Name="TxtTelNC"
                                                             BorderThickness="0"
                                                             Background="Transparent"
                                                             FontSize="13" />
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Email"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="#2C1810"
                                                           Margin="0,0,0,4" />
                                                <Border Background="White"
                                                        CornerRadius="6"
                                                        Padding="8,6">
                                                    <TextBox x:Name="TxtMailNC"
                                                             BorderThickness="0"
                                                             Background="Transparent"
                                                             FontSize="13" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                        <Button Content="Valider ce client"
                                                Style="{StaticResource BtnPrincipalStyle}"
                                                HorizontalAlignment="Left"
                                                Click="BtnValiderNouveauClient_Click" />
                                    </StackPanel>
                                </Border>

                                <!-- Client sélectionné -->
                                <Border x:Name="PanelClientSelectionne"
                                        Visibility="Collapsed"
                                        Background="#F0FFF0"
                                        CornerRadius="8"
                                        Padding="12"
                                        Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="✓ Client sélectionné"
                                                   FontSize="11"
                                                   Foreground="#4CAF50"
                                                   FontWeight="SemiBold" />
                                        <TextBlock x:Name="TxtClientSelectionne"
                                                   FontSize="13"
                                                   Foreground="#2C1810"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Événement -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Événement"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#2C1810"
                                   Margin="0,0,0,12" />
                        <Border Background="White"
                                CornerRadius="12"
                                Padding="16">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Type d'événement"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="#2C1810"
                                                   Margin="0,0,0,6" />
                                        <ComboBox x:Name="CbTypeEvenement"
                                                  Height="34"
                                                  FontSize="13"
                                                  SelectionChanged="CbTypeEvenement_SelectionChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Nb de personnes"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="#2C1810"
                                                   Margin="0,0,0,6" />
                                        <Border Background="#F5EDE3"
                                                CornerRadius="8"
                                                Padding="10,6">
                                            <TextBox x:Name="TxtNbPersonnes"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     FontSize="13"
                                                     Text="0" />
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="Date de retrait *"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#2C1810"
                                               Margin="0,0,0,6" />
                                    <DatePicker x:Name="DpDateRetrait"
                                                Height="34"
                                                FontSize="13" />
                                </StackPanel>

                                <Border Background="#F5EDE3"
                                        CornerRadius="8"
                                        Padding="12">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Acompte calculé : "
                                                   FontSize="13"
                                                   Foreground="#2C1810" />
                                        <TextBlock x:Name="TxtAcompte2"
                                                   Text="0,00 €"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Foreground="#6B3A2A" />
                                        <TextBlock Text=" (25% du total)"
                                                   FontSize="12"
                                                   Foreground="#888" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ========== ÉTAPE 3 : RÉCAPITULATIF ========== -->
                <Grid x:Name="PanelEtape3"
                      Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="280" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <!-- Client -->
                        <Border Background="White"
                                CornerRadius="12"
                                Padding="20"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Client"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="#2C1810"
                                           Margin="0,0,0,12" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Nom"
                                                   FontSize="11"
                                                   Foreground="#888" />
                                        <TextBlock x:Name="RecapNom"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#2C1810" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Téléphone"
                                                   FontSize="11"
                                                   Foreground="#888" />
                                        <TextBlock x:Name="RecapTel"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#2C1810" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Événement -->
                        <Border Background="White"
                                CornerRadius="12"
                                Padding="20"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Événement"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="#2C1810"
                                           Margin="0,0,0,12" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Type"
                                                   FontSize="11"
                                                   Foreground="#888" />
                                        <TextBlock x:Name="RecapType"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#2C1810" />
                                        <TextBlock Text="Date de retrait"
                                                   FontSize="11"
                                                   Foreground="#888"
                                                   Margin="0,8,0,0" />
                                        <TextBlock x:Name="RecapDate"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#2C1810" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Nb personnes"
                                                   FontSize="11"
                                                   Foreground="#888" />
                                        <TextBlock x:Name="RecapNbP"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#2C1810" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Produits -->
                        <Border Background="White"
                                CornerRadius="12"
                                Padding="20">
                            <StackPanel>
                                <TextBlock Text="Produits commandés"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="#2C1810"
                                           Margin="0,0,0,12" />
                                <DataGrid x:Name="GridRecap"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          GridLinesVisibility="Horizontal"
                                          HeadersVisibility="Column"
                                          BorderThickness="0"
                                          Background="White"
                                          HorizontalGridLinesBrush="#F0E8E0"
                                          CanUserResizeColumns="False"
                                          FontSize="13"
                                          Foreground="#2C1810">
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background"
                                                    Value="White" />
                                            <Setter Property="Foreground"
                                                    Value="#888" />
                                            <Setter Property="FontSize"
                                                    Value="12" />
                                            <Setter Property="Padding"
                                                    Value="8,8" />
                                            <Setter Property="BorderThickness"
                                                    Value="0" />
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Produit"
                                                            Binding="{Binding Nom}"
                                                            Width="*" />
                                        <DataGridTextColumn Header="Format"
                                                            Binding="{Binding Format}"
                                                            Width="120" />
                                        <DataGridTextColumn Header="Qté"
                                                            Binding="{Binding Quantite}"
                                                            Width="50" />
                                        <DataGridTextColumn Header="Prix unitaire"
                                                            Binding="{Binding PrixStr}"
                                                            Width="100" />
                                        <DataGridTextColumn Header="Total"
                                                            Binding="{Binding SousTotalStr}"
                                                            Width="100" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Panneau droite : total + actions -->
                    <Border Grid.Column="2"
                            Background="White"
                            CornerRadius="12"
                            Padding="20"
                            VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Détails de la commande"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="#2C1810"
                                       Margin="0,0,0,16" />
                            <Border Background="#6B3A2A"
                                    CornerRadius="8"
                                    Padding="12"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Total commande"
                                               FontSize="12"
                                               Foreground="#E8D5C4" />
                                    <TextBlock x:Name="RecapTotal"
                                               Text="0,00 €"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               Foreground="White"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Acompte versé (25%)"
                                           FontSize="13"
                                           Foreground="#555" />
                                <TextBlock x:Name="RecapAcompte"
                                           Text="0,00 €"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="#2C1810"
                                           HorizontalAlignment="Right" />
                            </Grid>
                            <TextBlock x:Name="TxtErreurRecap"
                                       Text=""
                                       Foreground="Red"
                                       FontSize="12"
                                       Margin="0,0,0,8"
                                       Visibility="Collapsed"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- Footer : navigation -->
        <Border Grid.Row="2"
                Background="#F5EDE3"
                Padding="32,12">
            <Grid>
                <Button x:Name="BtnRetour"
                        Content="← Retour"
                        Style="{StaticResource BtnSecondaireStyle}"
                        HorizontalAlignment="Left"
                        Visibility="Collapsed"
                        Click="BtnRetour_Click" />
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="BtnAnnuler"
                            Content="Annuler"
                            Style="{StaticResource BtnSecondaireStyle}"
                            Margin="0,0,12,0"
                            Click="BtnAnnuler_Click" />
                    <Button x:Name="BtnSuivant"
                            Content="Suivant →"
                            Style="{StaticResource BtnPrincipalStyle}"
                            Click="BtnSuivant_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
