<Page x:Class="Classe_SAE201_bis.Pages.PageCatalogueProduits"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Classe_SAE201_bis.Pages"
      mc:Ignorable="d"
      Background="#F5EDE3"
      Title="PageCatalogueProduits">

    <Page.Resources>
        <Style x:Key="FiltreBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#2C1810"/>
            <Setter Property="BorderBrush" Value="#D4B89A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FiltreBtnActiveStyle" TargetType="Button"
               BasedOn="{StaticResource FiltreBtnStyle}">
            <Setter Property="Background" Value="#6B3A2A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#6B3A2A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="ActionBtnStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="32,28,32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Titre + bouton ajouter -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Gestion des produits"
                       FontSize="26" FontWeight="Bold" Foreground="#2C1810"/>
            <Button Grid.Column="1" Content="+ Ajouter un produit"
                    Click="BtnAjouterProduit_Click"
                    Background="#6B3A2A" Foreground="White"
                    Height="36" Padding="16,0" BorderThickness="0"
                    Cursor="Hand" FontSize="13" FontWeight="SemiBold">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- Filtres -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="BtnTous" Content="Tous" Tag="Tous"
                    Style="{StaticResource FiltreBtnActiveStyle}"
                    Click="FiltreBtn_Click" Margin="0,0,8,0"/>
            <Button Content="Gâteaux" Tag="Gâteaux"
                    Style="{StaticResource FiltreBtnStyle}"
                    Click="FiltreBtn_Click" Margin="0,0,8,0"/>
            <Button Content="Viennoiseries" Tag="Viennoiseries"
                    Style="{StaticResource FiltreBtnStyle}"
                    Click="FiltreBtn_Click" Margin="0,0,8,0"/>
            <Button Content="Pains" Tag="Pains"
                    Style="{StaticResource FiltreBtnStyle}"
                    Click="FiltreBtn_Click"/>
        </StackPanel>

        <!-- Toggle indisponibles -->
        <CheckBox Grid.Row="2" x:Name="ChkIndisponibles"
                  Content="Afficher les produits indisponibles"
                  Foreground="#6B4226" FontSize="12" Margin="0,0,0,12"
                  Checked="ChkIndisponibles_Changed"
                  Unchecked="ChkIndisponibles_Changed"/>

        <!-- Tableau -->
        <Border Grid.Row="3" Background="White" CornerRadius="12">
            <DataGrid x:Name="GridProduits" AutoGenerateColumns="False"
                      IsReadOnly="True" GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column" BorderThickness="0"
                      Background="White" RowBackground="White"
                      AlternatingRowBackground="#FAFAFA"
                      HorizontalGridLinesBrush="#F0E8E0"
                      SelectionMode="Single" CanUserResizeColumns="False"
                      CanUserReorderColumns="False" FontSize="13"
                      Foreground="#2C1810" Margin="16,8,16,8">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="Foreground" Value="#888"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="8,10"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Recette" Binding="{Binding RecetteNom}"
                                        Width="150" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Catégorie" Binding="{Binding CategorieNom}"
                                        Width="110" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Format" Binding="{Binding FormatStr}"
                                        Width="100" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Prix TTC" Binding="{Binding PrixStr}"
                                        Width="80" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Allergènes" Binding="{Binding AllergenesStr}"
                                        Width="*" IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="Statut" Width="110" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="12" Padding="10,4"
                                        Background="{Binding BgStatut}"
                                        HorizontalAlignment="Left" Margin="0,4">
                                    <TextBlock Text="{Binding StatutStr}"
                                               Foreground="{Binding FgStatut}"
                                               FontSize="12" FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Actions" Width="220" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center" Margin="0,4">
                                    <Button Content="✏ Modifier"
                                            Tag="{Binding ProduitId}"
                                            Click="BtnModifier_Click"
                                            Style="{StaticResource ActionBtnStyle}"
                                            Background="#F5EDE4" Foreground="#6B3A2A"
                                            Margin="0,0,6,0"/>
                                    <Button Content="{Binding BtnDispoLabel}"
                                            Tag="{Binding ProduitId}"
                                            Click="BtnToggleDisponible_Click"
                                            Style="{StaticResource ActionBtnStyle}"
                                            Background="{Binding BgBtnDispo}"
                                            Foreground="White"
                                            Margin="0,0,6,0"/>
                                    <Button Content="🗑"
                                            Tag="{Binding ProduitId}"
                                            Click="BtnSupprimer_Click"
                                            Style="{StaticResource ActionBtnStyle}"
                                            Background="#FDECEA" Foreground="#C0392B"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>
