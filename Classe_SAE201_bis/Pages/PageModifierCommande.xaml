<Page x:Class="Classe_SAE201_bis.Pages.PageModifierCommande"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Classe_SAE201_bis.Pages"
      mc:Ignorable="d"
      Background="#F5EDE3"
      Title="PageModifierCommande">

    <Page.Resources>
        <Style x:Key="FiltreBtnStyle"
               TargetType="Button">
            <Setter Property="Background"
                    Value="White" />
            <Setter Property="Foreground"
                    Value="#2C1810" />
            <Setter Property="BorderBrush"
                    Value="#D4B89A" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="FontSize"
                    Value="13" />
            <Setter Property="Height"
                    Value="32" />
            <Setter Property="Padding"
                    Value="14,0" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FiltreBtnActiveStyle"
               TargetType="Button"
               BasedOn="{StaticResource FiltreBtnStyle}">
            <Setter Property="Background"
                    Value="#6B3A2A" />
            <Setter Property="Foreground"
                    Value="White" />
            <Setter Property="BorderBrush"
                    Value="#6B3A2A" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
        </Style>
        <Style x:Key="BtnPrincipalStyle"
               TargetType="Button">
            <Setter Property="Height"
                    Value="40" />
            <Setter Property="Padding"
                    Value="20,0" />
            <Setter Property="FontSize"
                    Value="13" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Background"
                    Value="#6B3A2A" />
            <Setter Property="Foreground"
                    Value="White" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BtnSecondaireStyle"
               TargetType="Button"
               BasedOn="{StaticResource BtnPrincipalStyle}">
            <Setter Property="Background"
                    Value="White" />
            <Setter Property="Foreground"
                    Value="#2C1810" />
            <Setter Property="BorderBrush"
                    Value="#D4B89A" />
            <Setter Property="BorderThickness"
                    Value="1" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#F5EDE3"
                Padding="32,20,32,16">
            <StackPanel>
                <TextBlock x:Name="TxtTitre"
                           Text="Modifier la commande"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#2C1810"
                           Margin="0,0,0,4" />
                <TextBlock x:Name="TxtSousTitre"
                           Text=""
                           FontSize="13"
                           Foreground="#888" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <Grid Margin="32,16,32,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="240" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Border Background="White"
                            CornerRadius="10"
                            Margin="0,0,0,12"
                            Padding="12,8">
                        <Grid>
                            <TextBox x:Name="TxtRechercheProduit"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontSize="14"
                                     Foreground="#2C1810"
                                     CaretBrush="#2C1810"
                                     VerticalContentAlignment="Center"
                                     Height="30"
                                     TextChanged="TxtRechercheProduit_TextChanged" />
                            <TextBlock x:Name="PlaceholderProduit"
                                       Text="🔍  Rechercher un produit..."
                                       Foreground="#AAAAAA"
                                       FontSize="14"
                                       VerticalAlignment="Center"
                                       Margin="2,0,0,0"
                                       IsHitTestVisible="False" />
                        </Grid>
                    </Border>
                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,16">
                        <Button x:Name="BtnTous"
                                Content="Tous"
                                Style="{StaticResource FiltreBtnActiveStyle}"
                                Margin="0,0,8,0"
                                Click="FiltreCat_Click"
                                Tag="Tous" />
                        <Button x:Name="BtnGateaux"
                                Content="Gâteaux"
                                Style="{StaticResource FiltreBtnStyle}"
                                Margin="0,0,8,0"
                                Click="FiltreCat_Click"
                                Tag="Gâteaux" />
                        <Button x:Name="BtnViennoiseries"
                                Content="Viennoiseries"
                                Style="{StaticResource FiltreBtnStyle}"
                                Margin="0,0,8,0"
                                Click="FiltreCat_Click"
                                Tag="Viennoiseries" />
                        <Button x:Name="BtnPains"
                                Content="Pains"
                                Style="{StaticResource FiltreBtnStyle}"
                                Click="FiltreCat_Click"
                                Tag="Pains" />
                    </StackPanel>
                    <ItemsControl x:Name="ListeProduits">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="200"
                                        Margin="0,0,12,12"
                                        Background="White"
                                        CornerRadius="12"
                                        Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="{Binding RecetteNom}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="#2C1810"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Allergenes}"
                                                   FontSize="10"
                                                   Foreground="#B07050"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,8" />
                                        <ComboBox x:Name="CbFormat"
                                                  ItemsSource="{Binding Formats}"
                                                  DisplayMemberPath="Libelle"
                                                  Height="30"
                                                  FontSize="12"
                                                  Tag="{Binding RecetteId}"
                                                  SelectionChanged="CbFormat_SelectionChanged" />
                                        <Button Content="+ Ajouter"
                                                Margin="0,8,0,0"
                                                Height="32"
                                                FontSize="12"
                                                Background="#6B3A2A"
                                                Foreground="White"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                Tag="{Binding RecetteId}"
                                                Click="BtnAjouter_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="6">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <Border Grid.Column="2"
                        Background="White"
                        CornerRadius="12"
                        Padding="16"
                        VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Commande actuelle"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#2C1810"
                                   Margin="0,0,0,12" />
                        <ItemsControl x:Name="ListeSelection">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#F0E8E0"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Nom}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="#2C1810" />
                                                <TextBlock Text="{Binding Format}"
                                                           FontSize="11"
                                                           Foreground="#888" />
                                                <StackPanel Orientation="Horizontal"
                                                            Margin="0,4,0,0">
                                                    <Button Content="−"
                                                            Width="24"
                                                            Height="24"
                                                            FontSize="14"
                                                            Background="#F5EDE3"
                                                            Foreground="#2C1810"
                                                            BorderThickness="0"
                                                            Cursor="Hand"
                                                            Tag="{Binding ProduitId}"
                                                            Click="BtnMoins_Click">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}"
                                                                        CornerRadius="4">
                                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                                      VerticalAlignment="Center" />
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                    <TextBlock Text="{Binding Quantite}"
                                                               FontSize="13"
                                                               VerticalAlignment="Center"
                                                               Margin="8,0" />
                                                    <Button Content="+"
                                                            Width="24"
                                                            Height="24"
                                                            FontSize="14"
                                                            Background="#F5EDE3"
                                                            Foreground="#2C1810"
                                                            BorderThickness="0"
                                                            Cursor="Hand"
                                                            Tag="{Binding ProduitId}"
                                                            Click="BtnPlus_Click">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}"
                                                                        CornerRadius="4">
                                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                                      VerticalAlignment="Center" />
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding SousTotalStr}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="#2C1810"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="TxtPanier0"
                                   Text="Aucun produit"
                                   FontSize="12"
                                   Foreground="#AAAAAA"
                                   HorizontalAlignment="Center"
                                   Margin="0,16,0,0" />
                        <Border BorderBrush="#F0E8E0"
                                BorderThickness="0,1,0,0"
                                Margin="0,12,0,0"
                                Padding="0,12,0,0">
                            <StackPanel>
                                <Border Background="#6B3A2A"
                                        CornerRadius="8"
                                        Padding="12"
                                        Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="Total commande"
                                                   FontSize="12"
                                                   Foreground="#E8D5C4" />
                                        <TextBlock x:Name="TxtTotal"
                                                   Text="0,00 €"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   Foreground="White"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                                <Grid>
                                    <TextBlock Text="Acompte (25%)"
                                               FontSize="12"
                                               Foreground="#888" />
                                    <TextBlock x:Name="TxtAcompte"
                                               Text="0,00 €"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="#2C1810"
                                               HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="#F5EDE3"
                Padding="32,12">
            <Grid>
                <Button Content="← Retour"
                        Style="{StaticResource BtnSecondaireStyle}"
                        HorizontalAlignment="Left"
                        Click="BtnRetour_Click" />
                <Button Content="✓ Enregistrer les modifications"
                        Style="{StaticResource BtnPrincipalStyle}"
                        HorizontalAlignment="Right"
                        Click="BtnEnregistrer_Click" />
            </Grid>
        </Border>
    </Grid>
</Page>
