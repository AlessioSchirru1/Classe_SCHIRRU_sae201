<Page x:Class="Classe_SAE201_bis.Pages.PageGestionCommandes"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Classe_SAE201_bis.Pages"
      mc:Ignorable="d"
      Background="#F5EDE3"
      Title="PageGestionCommandes" Height="700" Width="1000">

    <Page.Resources>
        <Style x:Key="FiltreBtnStyle"
               TargetType="Button">
            <Setter Property="Background"
                    Value="White" />
            <Setter Property="Foreground"
                    Value="#2C1810" />
            <Setter Property="BorderBrush"
                    Value="#D4B89A" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="FontSize"
                    Value="13" />
            <Setter Property="Height"
                    Value="34" />
            <Setter Property="Padding"
                    Value="16,0" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FiltreBtnActiveStyle"
               TargetType="Button"
               BasedOn="{StaticResource FiltreBtnStyle}">
            <Setter Property="Background"
                    Value="#6B3A2A" />
            <Setter Property="Foreground"
                    Value="White" />
            <Setter Property="BorderBrush"
                    Value="#6B3A2A" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
        </Style>

        <Style x:Key="ActionBtnStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="32,28,32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Titre -->
        <TextBlock Grid.Row="0"
                   Text="Gestion des commandes"
                   FontSize="26"
                   FontWeight="Bold"
                   Foreground="#2C1810"
                   Margin="0,0,0,20" />

        <!-- Filtres -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,0,0,20">
            <Button x:Name="BtnTous"
                    Content="Toutes"
                    Style="{StaticResource FiltreBtnActiveStyle}"
                    Margin="0,0,8,0"
                    Click="FiltreBtn_Click"
                    Tag="Toutes" />
            <Button x:Name="BtnEnAttente"
                    Content="En attente"
                    Style="{StaticResource FiltreBtnStyle}"
                    Margin="0,0,8,0"
                    Click="FiltreBtn_Click"
                    Tag="En attente" />
            <Button x:Name="BtnPretes"
                    Content="Prêtes"
                    Style="{StaticResource FiltreBtnStyle}"
                    Margin="0,0,8,0"
                    Click="FiltreBtn_Click"
                    Tag="Prêtes" />
            <Button x:Name="BtnRestituees"
                    Content="Restituées"
                    Style="{StaticResource FiltreBtnStyle}"
                    Click="FiltreBtn_Click"
                    Tag="Restituées" />
        </StackPanel>

        <!-- Tableau -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="12">
            <DataGrid x:Name="GridCommandes"
                      AutoGenerateColumns="False"
                      IsReadOnly="False"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      BorderThickness="0"
                      Background="White"
                      RowBackground="White"
                      AlternatingRowBackground="#FAFAFA"
                      HorizontalGridLinesBrush="#F0E8E0"
                      SelectionMode="Single"
                      CanUserResizeColumns="False"
                      CanUserReorderColumns="False"
                      FontSize="13"
                      Foreground="#2C1810"
                      Margin="16,8,16,8">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background"
                                Value="White" />
                        <Setter Property="Foreground"
                                Value="#888" />
                        <Setter Property="FontSize"
                                Value="12" />
                        <Setter Property="FontWeight"
                                Value="SemiBold" />
                        <Setter Property="Padding"
                                Value="8,10" />
                        <Setter Property="BorderThickness"
                                Value="0" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Client"
                                        Binding="{Binding NomClient}"
                                        Width="160"
                                        IsReadOnly="True" />
                    <DataGridTextColumn Header="Date retrait"
                                        Binding="{Binding DateRetrait}"
                                        Width="120"
                                        IsReadOnly="True" />
                    <DataGridTextColumn Header="Nb personnes"
                                        Binding="{Binding NbPersonnes}"
                                        Width="110"
                                        IsReadOnly="True" />
                    <DataGridTextColumn Header="Total"
                                        Binding="{Binding TotalStr}"
                                        Width="100"
                                        IsReadOnly="True" />

                    <!-- Statut badge -->
                    <DataGridTemplateColumn Header="Statut"
                                            Width="120"
                                            IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="12"
                                        Padding="10,4"
                                        Background="{Binding CouleurStatut}"
                                        HorizontalAlignment="Left"
                                        Margin="0,4">
                                    <TextBlock Text="{Binding StatutStr}"
                                               Foreground="White"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- ComboBox statut modifiable -->
                    <DataGridTemplateColumn Header="Modifier statut"
                                            Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox x:Name="CbStatut"
                                          SelectedItem="{Binding StatutSelectionne, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          ItemsSource="{Binding StatutsPossibles}"
                                          Width="160"
                                          Height="30"
                                          FontSize="12"
                                          SelectionChanged="CbStatut_SelectionChanged"
                                          Tag="{Binding CommandeId}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Actions" Width="100" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="✏ Modifier"
                    Tag="{Binding CommandeId}"
                    Click="BtnModifier_Click"
                    Style="{StaticResource ActionBtnStyle}"
                    Background="#F5EDE4" Foreground="#6B3A2A"
                    Margin="0,4"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>
