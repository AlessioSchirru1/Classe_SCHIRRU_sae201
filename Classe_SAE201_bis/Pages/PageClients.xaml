<Page x:Class="Classe_SAE201_bis.Pages.PageClients"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Classe_SAE201_bis.Pages"
      mc:Ignorable="d"
      Background="#F5EDE3"
      Title="PageClients">

    <Page.Resources>
        <Style x:Key="CarteStyle"
               TargetType="Border">
            <Setter Property="Background"
                    Value="White" />
            <Setter Property="CornerRadius"
                    Value="12" />
            <Setter Property="Padding"
                    Value="20,16" />
        </Style>
    </Page.Resources>

    <Grid Margin="32,28,32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Titre + bouton nouveau client -->
        <Grid Grid.Row="0"
              Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Clients"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#2C1810" />
                <TextBlock Text="Gérez vos clients et consultez leur historique"
                           FontSize="13"
                           Foreground="#888"
                           Margin="0,4,0,0" />
            </StackPanel>
            <Button Content="+ Nouveau client"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Height="38"
                    Padding="16,0"
                    FontSize="13"
                    Background="#6B3A2A"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="BtnNouveauClient_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- Cartes stats -->
        <Grid Grid.Row="1"
              Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource CarteStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Total clients"
                                   FontSize="13"
                                   Foreground="#555" />
                        <TextBlock Text="👥"
                                   FontSize="18"
                                   Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="TxtTotalClients"
                               Text="0"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="#2C1810"
                               Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Style="{StaticResource CarteStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Avec commandes"
                                   FontSize="13"
                                   Foreground="#555" />
                        <TextBlock Text="🛒"
                                   FontSize="18"
                                   Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="TxtAvecCommandes"
                               Text="0"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="#4CAF50"
                               Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="4"
                    Style="{StaticResource CarteStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Sans commande"
                                   FontSize="13"
                                   Foreground="#555" />
                        <TextBlock Text="👤"
                                   FontSize="18"
                                   Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="TxtSansCommande"
                               Text="0"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="#FF9800"
                               Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Barre recherche -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="10"
                Margin="0,0,0,16"
                Padding="12,8">
            <Grid>
                <TextBox x:Name="TxtRecherche"
                         Background="Transparent"
                         BorderThickness="0"
                         FontSize="14"
                         Foreground="#2C1810"
                         CaretBrush="#2C1810"
                         VerticalContentAlignment="Center"
                         Height="30"
                         TextChanged="TxtRecherche_TextChanged" />
                <TextBlock x:Name="PlaceholderRecherche"
                           Text="🔍  Rechercher par nom, email ou téléphone..."
                           Foreground="#AAAAAA"
                           FontSize="14"
                           VerticalAlignment="Center"
                           Margin="2,0,0,0"
                           IsHitTestVisible="False" />
            </Grid>
        </Border>

        <!-- Titre liste -->
        <TextBlock Grid.Row="3"
                   x:Name="TxtNbClients"
                   Text="Liste des clients"
                   FontSize="15"
                   FontWeight="SemiBold"
                   Foreground="#2C1810"
                   Margin="0,0,0,12" />

        <!-- Tableau -->
        <Border Grid.Row="4"
                Background="White"
                CornerRadius="12">
            <DataGrid x:Name="GridClients"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      BorderThickness="0"
                      Background="White"
                      RowBackground="White"
                      AlternatingRowBackground="#FAFAFA"
                      HorizontalGridLinesBrush="#F0E8E0"
                      SelectionMode="Single"
                      CanUserResizeColumns="False"
                      CanUserReorderColumns="False"
                      FontSize="13"
                      Foreground="#2C1810"
                      Margin="16,8,16,8">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background"
                                Value="White" />
                        <Setter Property="Foreground"
                                Value="#888" />
                        <Setter Property="FontSize"
                                Value="12" />
                        <Setter Property="FontWeight"
                                Value="SemiBold" />
                        <Setter Property="Padding"
                                Value="8,10" />
                        <Setter Property="BorderThickness"
                                Value="0" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    
                    <DataGridTextColumn Header="Nom"
                                        Binding="{Binding NomComplet}"
                                        Width="160" />
                    <DataGridTextColumn Header="Email"
                                        Binding="{Binding Mail}"
                                        Width="200" />
                    <DataGridTextColumn Header="Téléphone"
                                        Binding="{Binding Telephone}"
                                        Width="130" />
                    <DataGridTextColumn Header="Commandes"
                                        Binding="{Binding NbCommandes}"
                                        Width="100" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>
