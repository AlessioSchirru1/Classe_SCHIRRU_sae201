<Window x:Class="Classe_SAE201_bis.Pages.WindowAjouterFormat"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ajouter un format"
        Height="360" Width="400"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#F5EDE3">

    <Grid>
        <!-- Bouton fermer -->
        <Button Content="✕"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,10,10,0"
                Width="30" Height="30"
                FontSize="14"
                Foreground="#2C1810"
                Background="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                Click="BtnAnnuler_Click"/>

        <!-- Carte -->
        <Border Margin="24,50,24,24"
                Background="White"
                CornerRadius="16"
                Padding="24,20">
            <StackPanel>
                <TextBlock x:Name="TxtTitre"
                           FontSize="15" FontWeight="Bold"
                           Foreground="#2C1810" FontFamily="Georgia"
                           Margin="0,0,0,24" TextWrapping="Wrap"/>

                <TextBlock Text="Nombre de parts / taille du lot"
                           FontSize="12" Foreground="#888" Margin="0,0,0,6"/>
                <Border Background="#F5EDE3" CornerRadius="8" Margin="0,0,0,16">
                    <TextBox x:Name="TxtNbParts" Text="1"
                             BorderThickness="0" Background="Transparent"
                             Padding="14,10" FontSize="13" Foreground="#2C1810"
                             Height="42"/>
                </Border>

                <TextBlock Text="Prix TTC (€)"
                           FontSize="12" Foreground="#888" Margin="0,0,0,6"/>
                <Border Background="#F5EDE3" CornerRadius="8" Margin="0,0,0,16">
                    <TextBox x:Name="TxtPrix"
                             BorderThickness="0" Background="Transparent"
                             Padding="14,10" FontSize="13" Foreground="#2C1810"
                             Height="42"/>
                </Border>

                <TextBlock x:Name="TxtErreur" Foreground="#C0392B"
                           FontSize="12" Margin="0,0,0,10" Visibility="Collapsed"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Annuler"
                            Click="BtnAnnuler_Click"
                            Height="42" FontSize="13" FontWeight="SemiBold"
                            Foreground="#6B3A2A" Background="#F5EDE4"
                            BorderThickness="0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Grid.Column="2" Content="Ajouter"
                            Click="BtnAjouter_Click"
                            Height="42" FontSize="13" FontWeight="SemiBold"
                            Foreground="White" Background="#6B3A2A"
                            BorderThickness="0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
