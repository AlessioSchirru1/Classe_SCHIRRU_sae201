<Window x:Class="Classe_SAE201_bis.Pages.WindowAjouterProduit"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ajouter un produit" Height="580" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None"
        Background="#F5EDE3">

    <Grid>
        <!-- Croix fermer -->
        <Button Content="✕"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,10,10,0" Width="30" Height="30"
                FontSize="14" Foreground="#2C1810"
                Background="Transparent" BorderThickness="0"
                Cursor="Hand" Click="BtnAnnuler_Click"/>

        <Border Margin="20,40,20,20"
                Background="White" CornerRadius="16" Padding="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="28">
                    <TextBlock Text="Ajouter un produit" FontSize="18" FontWeight="Bold"
                               Foreground="#2C1810" FontFamily="Georgia" Margin="0,0,0,20"/>

                    <!-- Recette -->
                    <TextBlock Text="Recette" FontSize="12" Foreground="#888" Margin="0,0,0,6"/>
                    <ComboBox x:Name="CbRecette" Margin="0,0,0,8" Padding="10,8" FontSize="13"/>
                    <Button Content="+ Créer une nouvelle recette" Click="BtnNouvelleRecette_Click"
                            Background="Transparent" Foreground="#6B3A2A" BorderThickness="0"
                            FontSize="12" HorizontalAlignment="Left" Cursor="Hand" Margin="0,0,0,12"/>

                    <!-- Panel nouvelle recette -->
                    <Border x:Name="PanelNouvelleRecette" Visibility="Collapsed"
                            Background="#FDF6EC" CornerRadius="8" Padding="16" Margin="0,0,0,14"
                            BorderBrush="#D4B89A" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Nouvelle recette" FontSize="13" FontWeight="SemiBold"
                                       Foreground="#2C1810" Margin="0,0,0,12"/>
                            <TextBlock Text="Nom" FontSize="12" Foreground="#888" Margin="0,0,0,4"/>
                            <Border BorderBrush="#D4B89A" BorderThickness="1" CornerRadius="6"
                                    Padding="10,8" Margin="0,0,0,10">
                                <TextBox x:Name="TxtNomRecette" BorderThickness="0"
                                         Background="Transparent" FontSize="13"/>
                            </Border>
                            <TextBlock Text="Description" FontSize="12" Foreground="#888" Margin="0,0,0,4"/>
                            <Border BorderBrush="#D4B89A" BorderThickness="1" CornerRadius="6"
                                    Padding="10,8" Margin="0,0,0,10">
                                <TextBox x:Name="TxtDescRecette" BorderThickness="0"
                                         Background="Transparent" FontSize="13"/>
                            </Border>
                            <TextBlock Text="Catégorie" FontSize="12" Foreground="#888" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CbCategorie" Margin="0,0,0,10" Padding="10,8" FontSize="13"/>
                            <TextBlock Text="Allergènes" FontSize="12" Foreground="#888" Margin="0,0,0,6"/>
                            <ListBox x:Name="ListAllergenes" MaxHeight="120" BorderThickness="0"
                                     Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Nom}" IsChecked="{Binding Coche}"
                                                  FontSize="12" Foreground="#2C1810"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="TxtErreurRecette" Foreground="#C0392B" FontSize="12"
                                       Margin="0,8,0,0" Visibility="Collapsed"/>
                            <Button Content="Créer la recette" Click="BtnCreerRecette_Click"
                                    Background="#6B3A2A" Foreground="White" Padding="0,10"
                                    BorderThickness="0" FontSize="13" Cursor="Hand" Margin="0,10,0,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Nb parts -->
                    <TextBlock Text="Nombre de parts / taille du lot"
                               FontSize="12" Foreground="#888" Margin="0,0,0,6"/>
                    <Border BorderBrush="#D4B89A" BorderThickness="1" CornerRadius="8"
                            Padding="12,10" Margin="0,0,0,14">
                        <TextBox x:Name="TxtNbParts" Text="1" BorderThickness="0"
                                 Background="Transparent" FontSize="13"/>
                    </Border>

                    <!-- Prix -->
                    <TextBlock Text="Prix TTC (€)" FontSize="12" Foreground="#888" Margin="0,0,0,6"/>
                    <Border BorderBrush="#D4B89A" BorderThickness="1" CornerRadius="8"
                            Padding="12,10" Margin="0,0,0,14">
                        <TextBox x:Name="TxtPrix" BorderThickness="0"
                                 Background="Transparent" FontSize="13"/>
                    </Border>

                    <TextBlock x:Name="TxtErreur" Foreground="#C0392B" FontSize="12"
                               Margin="0,0,0,10" Visibility="Collapsed"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Annuler" Click="BtnAnnuler_Click"
                                Background="#F5EDE4" Foreground="#6B3A2A" Padding="0,12"
                                BorderThickness="0" FontSize="13" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Grid.Column="2" Content="Ajouter le produit" Click="BtnEnregistrer_Click"
                                Background="#6B3A2A" Foreground="White" Padding="0,12"
                                BorderThickness="0" FontSize="13" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
