<Window x:Class="Classe_SAE201_bis.Pages.WindowModifierProduit"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modifier un produit"
        Height="320" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="#F5EDE3">

    <Grid>
        <!-- Croix fermer -->
        <Button Content="✕"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,10,10,0"
                Width="30" Height="30"
                FontSize="14"
                Foreground="#2C1810"
                Background="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                Click="BtnAnnuler_Click"/>

        <Border Width="340"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Background="White"
                CornerRadius="16"
                Padding="28,24">
            <StackPanel>
                <TextBlock x:Name="TxtTitre"
                           FontSize="16" FontWeight="Bold"
                           FontFamily="Georgia"
                           Foreground="#2C1810"
                           Margin="0,0,0,20"
                           TextWrapping="Wrap"/>

                <TextBlock Text="Prix TTC (€)"
                           FontSize="12" Foreground="#888"
                           Margin="0,0,0,6"/>
                <Border Background="#F5EDE3" CornerRadius="8" Margin="0,0,0,14">
                    <TextBox x:Name="TxtPrix"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="12,10" FontSize="13"
                             Foreground="#2C1810" Height="38"/>
                </Border>

                <CheckBox x:Name="ChkIndisponible"
                          Content="Marquer comme indisponible"
                          Foreground="#2C1810" FontSize="12"
                          Margin="0,0,0,14"/>

                <TextBlock x:Name="TxtErreur"
                           Foreground="#C0392B" FontSize="12"
                           Margin="0,0,0,10" Visibility="Collapsed"/>

                <!-- Boutons -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="Supprimer"
                            Click="BtnSupprimer_Click"
                            Padding="0,10" BorderThickness="0"
                            FontSize="12" Cursor="Hand"
                            Foreground="#C0392B" Background="#FDECEA">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Grid.Column="2" Content="Annuler"
                            Click="BtnAnnuler_Click"
                            Padding="0,10" BorderThickness="0"
                            FontSize="12" Cursor="Hand"
                            Foreground="#6B3A2A" Background="#F5EDE4">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Grid.Column="4" Content="Enregistrer"
                            Click="BtnEnregistrer_Click"
                            Padding="0,10" BorderThickness="0"
                            FontSize="12" Cursor="Hand"
                            Foreground="White" Background="#6B3A2A">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
