<Window x:Class="Classe_SAE201_bis.Pages.WindowModifierProduit"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modifier un produit" Height="280" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#FDF6EC">
    <StackPanel Margin="28">
        <TextBlock x:Name="TxtTitre" FontSize="16" FontWeight="Bold"
                   Foreground="#3B1F0E" FontFamily="Georgia" Margin="0,0,0,20"/>

        <TextBlock Text="Prix TTC (€)" FontSize="12" Foreground="#9E7B5A" Margin="0,0,0,6"/>
        <Border BorderBrush="#E8D8C8" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,14">
            <TextBox x:Name="TxtPrix" BorderThickness="0" Background="Transparent" FontSize="13"/>
        </Border>

        <CheckBox x:Name="ChkIndisponible" Content="Marquer comme indisponible"
                  Foreground="#6B4226" FontSize="12" Margin="0,0,0,14"/>

        <TextBlock x:Name="TxtErreur" Foreground="#C0392B" FontSize="12"
                   Margin="0,0,0,10" Visibility="Collapsed"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Annuler" Click="BtnAnnuler_Click"
                    Background="#F5EDE4" Foreground="#8B5E3C" Padding="0,10"
                    BorderThickness="0" FontSize="13" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Grid.Column="2" Content="Enregistrer" Click="BtnEnregistrer_Click"
                    Background="#8B5E3C" Foreground="White" Padding="0,10"
                    BorderThickness="0" FontSize="13" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </StackPanel>
</Window>
